    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nest-commander": "^3.20.1",
    "nestjs-pino": "^4.3.0",
    "pdfmake": "^0.2.18",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
