# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
SERVICE_NAME=cercana-ti-backend

# =============================================================================
# Database provider: 'typeorm' (direct PostgreSQL) | 'supabase' (Supabase JS client)
# Both use the same Supabase Postgres database underneath.
# - 'typeorm'  → use TypeORM Repository API, QueryBuilder, migrations.
# - 'supabase' → use Supabase JS client (realtime, RLS, storage, auth).
# Switch freely without data changes; just restart the server.
# =============================================================================
DB_PROVIDER=typeorm

# =============================================================================
# Database — Supabase PostgreSQL (direct connection)
# Required for BOTH providers: TypeORM uses it for queries/migrations;
# when DB_PROVIDER=supabase TypeORM still needs it for schema management.
# Get from: Supabase > Project Settings > Database > Connection string
# =============================================================================
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# =============================================================================
# Supabase JS Client — only needed when DB_PROVIDER=supabase
# Get from: Supabase > Project Settings > API
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx

# =============================================================================
# Security
# =============================================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# Optional: Datadog APM Tracing
# Only needed if you want distributed tracing via Datadog
# =============================================================================
DD_TRACE_ENABLED=false
DD_SERVICE=cercana-ti-backend
DD_ENV=development
DD_VERSION=1.0.0
DD_API_KEY=
